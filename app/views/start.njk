{# The start page. Explains what the service is for, then one green button. #}

{% extends "layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageTitle %}Register a rubber duck - GOV.UK{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <h1 class="govuk-heading-xl">Register a rubber duck</h1>

    <p class="govuk-body-l">Use this service to register a rubber duck for use in a bathroom, pond or municipal fountain.</p>

    <h2 class="govuk-heading-m">Before you start</h2>

    <p class="govuk-body">You’ll need:</p>

    <ul class="govuk-list govuk-list--bullet">
      <li>the duck’s full name</li>
      <li>proof that the duck floats</li>
    </ul>

    <p class="govuk-body">Registering a duck takes around 2 minutes.</p>

    {{ govukButton({
      text: "Start now",
      href: "/name",
      isStartButton: true
    }) }}

  </div>
</div>
{% endblock %}
